    {
      "id": "0216b29d-7aa2-4cf6-89c9-adfbe767dd26",
      "book_id": "d782426d-5189-4543-9e8a-7a8a4ee7302c",
      "collection_id": "f3498dd2-f412-4485-bc35-ebb1a8cc7e78",
